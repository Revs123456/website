# Database (Supabase / PostgreSQL)
DB_HOST=your-db-host.supabase.com
DB_PORT=5432
DB_USER=postgres.your-project-ref
DB_PASS=your-db-password
DB_NAME=postgres

# JWT — use a 32+ character random string
JWT_SECRET=replace-with-a-strong-random-secret

# Razorpay — get from dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Email via Resend — get from resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=TechChampsByRev <onboarding@resend.dev>
ADMIN_EMAIL=connectwithrev@gmail.com

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://www.techchampsbyrev.in

# Runtime
NODE_ENV=production
PORT=4001
