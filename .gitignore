# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
frontend/.next/
frontend/out/

# Build
backend/dist/

# Env files
.env
.env.local
.env.*.local

# DB
backend/*.sqlite

# DB backups — contains production data, NEVER commit
db-backups/
*.sql.gz
*.dump

# Test coverage (backend/frontend .gitignore also cover their own — this
# catches jest-junit's output too, which resolves relative to cwd, not rootDir)
/coverage/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Claude local settings
.claude/settings.local.json

# Debug output files
backend/format_out.txt
backend/prisma_error.txt
backend/validate.txt
.vercel
.env*

# Terraform — state files hold every resource's full attributes in plaintext
# REGARDLESS of a variable's `sensitive = true` (that flag only hides CLI
# output, not the state file itself). Real credentials belong in
# TF_VAR_* env vars or a local terraform.tfvars, never committed.
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/terraform.tfvars
infra/**/*.tfplan
# .terraform.lock.hcl is deliberately NOT ignored — commit it, it pins
# provider version hashes for reproducibility (same idea as package-lock.json)
